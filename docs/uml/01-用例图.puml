actor "普通员工" as Emp

rectangle "智慧企业知识财富库系统" {
  usecase "登录系统" as UC1
  usecase "退出系统" as UC2
  usecase "管理知识文档" as UC3
  usecase "检索知识文档" as UC4
  usecase "智能问答" as UC5
  usecase "浏览知识图谱" as UC6
  usecase "收藏文档" as UC7
  usecase "维护分类" as UC8
  usecase "维护图谱关系" as UC9
  usecase "查看审计日志" as UC10
  usecase "查看用户列表" as UC11
}

Emp --> UC1
Emp --> UC2
Emp --> UC3
Emp --> UC4
Emp --> UC5
Emp --> UC6
Emp --> UC7

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
