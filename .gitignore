.venv/
__pycache__/
*.pyc
instance/*.db
instance/*.log
instance/*.pid
instance/_boot_server.py
.env
uploads/*
!uploads/.gitkeep
.DS_Store

# 测试与覆盖率
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# UML 本地渲染工具：jdk4py 自带 JRE 体积大，plantuml.jar 约 30MB，均不入库
# 需要时运行 scripts/setup_uml.py 一键准备（脚本会写入 .tools/）
.venv-*/
.venv-jdk*/
.venv-plantuml*/
.tools/plantuml/*.jar
.tools/fonts/*.ttf
.cache/

# Vue frontend dependencies and local QA artifacts
.wrangler/
frontend/node_modules/
frontend/.vite/
.codex-tmp/
docs/render/

# 服务包可能包含密钥，仅本地交付
deliverables/*.rar
deliverables/*.exe

# 文档目录只保留 Markdown，二进制交付物统一放 deliverables
docs/short/*.rar
docs/short/*.exe
